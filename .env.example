# tokenharbor-farm — inbox worker (catch-all) config
# Copy to `.env` lalu `set -a; . ./.env; set +a`, atau export langsung.
# Semua opsional: kosong = pakai default di src/inbox/index.mjs.

# Base URL API worker email, termasuk prefix /api.
TH_WORKER_API_BASE=

# Domain catch-all yang dilayani worker (alamat = farm<random>@domain).
TH_WORKER_DOMAIN=

# Bearer token, hanya kalau worker dilindungi auth.
TH_WORKER_TOKEN=
